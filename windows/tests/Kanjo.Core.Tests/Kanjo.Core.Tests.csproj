<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Kanjo.Core.Tests</RootNamespace>
    <AssemblyName>Kanjo.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kanjo.Core\Kanjo.Core.csproj" />
    <!-- 后台接线（AppServices）也要测：只引用程序集，不创建任何窗口。 -->
    <ProjectReference Include="..\..\src\Kanjo.App\Kanjo.App.csproj" />
  </ItemGroup>

</Project>
