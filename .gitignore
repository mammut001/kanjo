# macOS
.DS_Store

# Provisioning profiles (do not commit)
ui/Resources/*.provisionprofile

# Python
__pycache__/
*.pyc
.pytest_cache/

# Swift Package Manager
ui/.build/
ui/.swiftpm/
*.xcodeproj
*.xcworkspace

# Local exports and scratch
data.json
*.local.json

# Xcode build output
build-dd/

# iOS: commit the generated project (regenerate with `cd ios && xcodegen` after editing project.yml)
!ios/Kanjo.xcodeproj
!ios/Kanjo.xcodeproj/**
ios/Kanjo.xcodeproj/xcuserdata/
ios/Kanjo.xcodeproj/project.xcworkspace/xcuserdata/
